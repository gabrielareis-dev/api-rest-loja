@startuml
left to right direction
actor "Usuário da API" as Usuario
rectangle "API REST - I Love Donuts" {
  usecase "Cadastrar cliente" as C1
  usecase "Listar clientes" as C2
  usecase "Consultar cliente por ID" as C3
  usecase "Remover cliente" as C4
  usecase "Cadastrar produto" as P1
  usecase "Listar produtos" as P2
  usecase "Consultar produto por ID" as P3
  usecase "Remover produto" as P4
  usecase "Registrar pedido" as O1
  usecase "Listar pedidos" as O2
  usecase "Consultar pedido por ID" as O3
  usecase "Remover pedido" as O4
}
Usuario -- C1
Usuario -- C2
Usuario -- C3
Usuario -- C4
Usuario -- P1
Usuario -- P2
Usuario -- P3
Usuario -- P4
Usuario -- O1
Usuario -- O2
Usuario -- O3
Usuario -- O4
@enduml
